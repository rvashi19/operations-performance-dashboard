            "sourceColumn": "overdue_vs_analytical_target",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "OpenRequests",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"open_requests.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"unique_key\", \"agency_code\", \"complaint_type\", \"incident_zip\", \"status\", \"created_at\", \"age_days\", \"aging_bucket\", \"overdue_vs_analytical_target\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"unique_key\", type text}, {\"agency_code\", type text}, {\"complaint_type\", type text}, {\"incident_zip\", type text}, {\"status\", type text}, {\"created_at\", type datetime}, {\"age_days\", Int64.Type}, {\"aging_bucket\", type text}, {\"overdue_vs_analytical_target\", type logical}}, \"en-US\"),\n    Result = Typed\nin\n    Result"
            }
          }
        ],
        "measures": [
          {
            "name": "Current Backlog",
            "expression": "COUNTROWS ( OpenRequests )",
            "formatString": "#,0"
          },
          {
            "name": "Overdue Open Requests",
            "expression": "CALCULATE ( COUNTROWS ( OpenRequests ), OpenRequests[overdue_vs_analytical_target] = TRUE () )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Backlog Age Days",
            "expression": "AVERAGE ( OpenRequests[age_days] )",
            "formatString": "#,0"
          }
        ]
      },
