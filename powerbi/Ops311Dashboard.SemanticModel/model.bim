            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"dq_issues.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"issue_id\", \"unique_key\", \"record_hash\", \"rule_id\", \"rule_name\", \"issue_category\", \"severity\", \"affected_column\", \"original_value\", \"recommended_treatment\", \"resolution_status\", \"agency\", \"complaint_type\", \"status\", \"created_at\", \"closed_at\", \"created_month\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"issue_id\", Int64.Type}, {\"unique_key\", type text}, {\"record_hash\", type text}, {\"rule_id\", type text}, {\"rule_name\", type text}, {\"issue_category\", type text}, {\"severity\", type text}, {\"affected_column\", type text}, {\"original_value\", type text}, {\"recommended_treatment\", type text}, {\"resolution_status\", type text}, {\"agency\", type text}, {\"complaint_type\", type text}, {\"status\", type text}, {\"created_at\", type datetime}, {\"closed_at\", type datetime}, {\"created_month\", type text}}, \"en-US\"),\n    Result = Typed\nin\n    Result"
