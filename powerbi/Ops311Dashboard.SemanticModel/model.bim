{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "ExportFolder",
        "kind": "m",
        "expression": "\"C:\\\\Users\\\\raviv\\\\OneDrive\\\\Desktop\\\\operational dashboard\\\\data\\\\exports\\\\\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Requests",
        "columns": [
          {
            "name": "unique_key",
            "dataType": "string",
            "sourceColumn": "unique_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "status_group",
            "dataType": "string",
            "sourceColumn": "status_group",
            "summarizeBy": "none"
          },
          {
            "name": "created_at",
            "dataType": "dateTime",
            "sourceColumn": "created_at",
            "summarizeBy": "none"
          },
          {
            "name": "closed_at",
            "dataType": "dateTime",
            "sourceColumn": "closed_at",
            "summarizeBy": "none"
          },
          {
            "name": "effective_closed_at",
            "dataType": "dateTime",
            "sourceColumn": "effective_closed_at",
            "summarizeBy": "none"
          },
          {
            "name": "created_date_key",
            "dataType": "int64",
            "sourceColumn": "created_date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "closed_date_key",
            "dataType": "int64",
            "sourceColumn": "closed_date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "agency_code",
            "dataType": "string",
            "sourceColumn": "agency_code",
            "summarizeBy": "none"
          },
          {
            "name": "complaint_type",
            "dataType": "string",
            "sourceColumn": "complaint_type",
            "summarizeBy": "none"
          },
          {
            "name": "descriptor",
            "dataType": "string",
            "sourceColumn": "descriptor",
            "summarizeBy": "none"
          },
          {
            "name": "incident_zip",
            "dataType": "string",
            "sourceColumn": "incident_zip",
            "summarizeBy": "none"
          },
          {
            "name": "community_board",
            "dataType": "string",
            "sourceColumn": "community_board",
            "summarizeBy": "none"
          },
          {
            "name": "resolution_hours",
            "dataType": "double",
            "sourceColumn": "resolution_hours",
            "summarizeBy": "none"
          },
          {
            "name": "resolution_days",
            "dataType": "double",
            "sourceColumn": "resolution_days",
            "summarizeBy": "none"
          },
          {
            "name": "include_in_resolution_metrics",
            "dataType": "boolean",
            "sourceColumn": "include_in_resolution_metrics",
            "summarizeBy": "none"
          },
          {
            "name": "within_analytical_target",
            "dataType": "boolean",
            "sourceColumn": "within_analytical_target",
            "summarizeBy": "none"
          },
          {
            "name": "dq_issue_count",
            "dataType": "int64",
            "sourceColumn": "dq_issue_count",
            "summarizeBy": "none"
          },
          {
            "name": "dq_max_severity",
            "dataType": "string",
            "sourceColumn": "dq_max_severity",
            "summarizeBy": "none"
          },
          {
            "name": "needs_manual_review",
            "dataType": "boolean",
            "sourceColumn": "needs_manual_review",
            "summarizeBy": "none"
          },
          {
            "name": "created_month",
            "dataType": "string",
            "sourceColumn": "created_month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Requests",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"fact_service_requests.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"unique_key\", \"status\", \"status_group\", \"created_at\", \"closed_at\", \"effective_closed_at\", \"created_date_key\", \"closed_date_key\", \"channel\", \"agency_code\", \"complaint_type\", \"descriptor\", \"incident_zip\", \"community_board\", \"resolution_hours\", \"resolution_days\", \"include_in_resolution_metrics\", \"within_analytical_target\", \"dq_issue_count\", \"dq_max_severity\", \"needs_manual_review\", \"created_month\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"unique_key\", type text}, {\"status\", type text}, {\"status_group\", type text}, {\"created_at\", type datetime}, {\"closed_at\", type datetime}, {\"effective_closed_at\", type datetime}, {\"created_date_key\", Int64.Type}, {\"closed_date_key\", Int64.Type}, {\"channel\", type text}, {\"agency_code\", type text}, {\"complaint_type\", type text}, {\"descriptor\", type text}, {\"incident_zip\", type text}, {\"community_board\", type text}, {\"resolution_hours\", type number}, {\"resolution_days\", type number}, {\"include_in_resolution_metrics\", type logical}, {\"within_analytical_target\", type logical}, {\"dq_issue_count\", Int64.Type}, {\"dq_max_severity\", type text}, {\"needs_manual_review\", type logical}, {\"created_month\", type text}}, \"en-US\"),\n    Result = Typed\nin\n    Result"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Requests",
            "expression": "COUNTROWS ( Requests )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Closed Requests",
            "expression": "CALCULATE ( [Total Requests], Requests[status_group] = \"Closed\" )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Open Requests",
            "expression": "CALCULATE ( [Total Requests], Requests[status_group] = \"Open\" )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Resolution Rate",
            "expression": "DIVIDE ( [Closed Requests], [Total Requests] )",
            "formatString": "0.0%",
            "displayFolder": "Volume"
          },
          {
            "name": "Requests Created",
            "expression": "[Total Requests]",
            "formatString": "#,0",
            "displayFolder": "Flow"
          },
          {
            "name": "Requests Closed",
            "expression": "CALCULATE ( COUNTROWS ( Requests ), USERELATIONSHIP ( Requests[closed_date_key], Calendar[date_key] ), NOT ISBLANK ( Requests[effective_closed_at] ), Requests[closed_date_key] IN VALUES ( Calendar[date_key] ) )",
            "formatString": "#,0",
            "displayFolder": "Flow"
          },
          {
            "name": "Net Backlog Change",
            "expression": "[Requests Created] - [Requests Closed]",
            "formatString": "#,0",
            "displayFolder": "Flow"
          },
          {
            "name": "Avg Resolution Hours",
            "expression": "AVERAGE ( Requests[resolution_hours] )",
            "formatString": "#,0.0",
            "displayFolder": "Resolution"
          },
          {
            "name": "Median Resolution Hours",
            "expression": "MEDIAN ( Requests[resolution_hours] )",
            "formatString": "#,0.0",
            "displayFolder": "Resolution"
          },
          {
            "name": "P90 Resolution Hours",
            "expression": "PERCENTILE.INC ( Requests[resolution_hours], 0.9 )",
            "formatString": "#,0",
            "displayFolder": "Resolution"
          },
          {
            "name": "Median Resolution Days",
            "expression": "DIVIDE ( [Median Resolution Hours], 24 )",
            "formatString": "#,0.0",
            "displayFolder": "Resolution"
          },
          {
            "name": "Avg Resolution Days",
            "expression": "DIVIDE ( [Avg Resolution Hours], 24 )",
            "formatString": "#,0.0",
            "displayFolder": "Resolution"
          },
          {
            "name": "P90 Resolution Days",
            "expression": "DIVIDE ( [P90 Resolution Hours], 24 )",
            "formatString": "#,0.0",
            "displayFolder": "Resolution"
          },
          {
            "name": "Resolution Sample",
            "expression": "CALCULATE ( COUNTROWS ( Requests ), Requests[include_in_resolution_metrics] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Resolution"
          },
          {
            "name": "Within 7-Day Target %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( Requests ), Requests[within_analytical_target] = TRUE () ), [Resolution Sample] )",
            "formatString": "0.0%",
            "displayFolder": "Resolution"
          },
          {
            "name": "Records With DQ Issues",
            "expression": "CALCULATE ( COUNTROWS ( Requests ), Requests[dq_issue_count] > 0 )",
            "formatString": "#,0",
            "displayFolder": "Data Quality"
          },
          {
            "name": "DQ Pass Rate",
            "expression": "1 - DIVIDE ( [Records With DQ Issues], [Total Requests] )",
            "formatString": "0.00%",
            "displayFolder": "Data Quality"
          },
          {
            "name": "DQ Affected %",
            "expression": "DIVIDE ( [Records With DQ Issues], [Total Requests] )",
            "formatString": "0.00%",
            "displayFolder": "Data Quality"
          },
          {
            "name": "Pending Manual Review",
            "expression": "CALCULATE ( COUNTROWS ( Requests ), Requests[needs_manual_review] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Data Quality"
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isKey": true
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none"
          },
          {
            "name": "quarter",
            "dataType": "int64",
            "sourceColumn": "quarter",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none",
            "sortByColumn": "month"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none"
          },
          {
            "name": "day_of_week",
            "dataType": "int64",
            "sourceColumn": "day_of_week",
            "summarizeBy": "none"
          },
          {
            "name": "day_name",
            "dataType": "string",
            "sourceColumn": "day_name",
            "summarizeBy": "none",
            "sortByColumn": "day_of_week"
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"dim_date.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"date_key\", \"full_date\", \"year\", \"quarter\", \"month\", \"month_name\", \"year_month\", \"day_of_week\", \"day_name\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"date_key\", Int64.Type}, {\"full_date\", type datetime}, {\"year\", Int64.Type}, {\"quarter\", Int64.Type}, {\"month\", Int64.Type}, {\"month_name\", type text}, {\"year_month\", type text}, {\"day_of_week\", Int64.Type}, {\"day_name\", type text}}, \"en-US\"),\n    Result = Table.SelectRows(Typed, each [year] = 2025)\nin\n    Result"
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "Agency",
        "columns": [
          {
            "name": "agency_code",
            "dataType": "string",
            "sourceColumn": "agency_code",
            "summarizeBy": "none"
          },
          {
            "name": "agency_name",
            "dataType": "string",
            "sourceColumn": "agency_name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Agency",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"dim_agency.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"agency_code\", \"agency_name\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"agency_code\", type text}, {\"agency_name\", type text}}, \"en-US\"),\n    Result = Typed\nin\n    Result"
            }
          }
        ]
      },
      {
        "name": "Backlog",
        "columns": [
          {
            "name": "month_end",
            "dataType": "dateTime",
            "sourceColumn": "month_end",
            "summarizeBy": "none"
          },
          {
            "name": "agency_code",
            "dataType": "string",
            "sourceColumn": "agency_code",
            "summarizeBy": "none"
          },
          {
            "name": "backlog",
            "dataType": "int64",
            "sourceColumn": "backlog",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Backlog",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(ExportFolder & \"backlog_monthly.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Selected = Table.SelectColumns(Promoted, {\"month_end\", \"agency_code\", \"backlog\"}),\n    Nulls = Table.TransformColumns(Selected, List.Transform(Table.ColumnNames(Selected), (c) => {c, each if _ = \"\" then null else _})),\n    Typed = Table.TransformColumnTypes(Nulls, {{\"month_end\", type datetime}, {\"agency_code\", type text}, {\"backlog\", Int64.Type}}, \"en-US\"),\n    Result = Typed\nin\n    Result"
            }
          }
        ],
        "measures": [
          {
            "name": "Month-End Backlog",
            "expression": "SUM ( Backlog[backlog] )",
            "formatString": "#,0"
          },
          {
            "name": "Year-End Backlog",
            "expression": "CALCULATE ( SUM ( Backlog[backlog] ), Backlog[month_end] = MAX ( Backlog[month_end] ) )",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "OpenRequests",
        "columns": [
          {
            "name": "unique_key",
